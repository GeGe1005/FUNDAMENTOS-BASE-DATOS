CREATE TABLE ESPECIALIDAD (
    id_especialidad INT IDENTITY(1,1) PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion VARCHAR(255)
);
GO

CREATE TABLE PACIENTE (
    id_paciente INT IDENTITY(1,1) PRIMARY KEY,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    cedula VARCHAR(10) UNIQUE NOT NULL,
    fecha_nacimiento DATE,
    direccion VARCHAR(255),
    telefono VARCHAR(15),
    email VARCHAR(100),
    fecha_registro DATETIME DEFAULT GETDATE()
);
GO

CREATE TABLE MEDICO (
    id_medico INT IDENTITY(1,1) PRIMARY KEY,
    nombres VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    cedula_profesional VARCHAR(20) UNIQUE NOT NULL,
    id_especialidad INT,
    telefono VARCHAR(15),
    email VARCHAR(100),
    CONSTRAINT FK_MEDICO_ESPECIALIDAD FOREIGN KEY (id_especialidad) REFERENCES ESPECIALIDAD(id_especialidad)
);
GO

CREATE TABLE CITA (
    id_cita INT IDENTITY(1,1) PRIMARY KEY,
    id_paciente INT NOT NULL,
    id_medico INT NOT NULL,
    fecha_hora DATETIME NOT NULL,
    motivo VARCHAR(255),
    estado VARCHAR(20) DEFAULT 'Programada' CHECK (estado IN ('Programada', 'Atendida', 'Cancelada', 'No Asistio')),
    observaciones VARCHAR(MAX),
    CONSTRAINT FK_CITA_PACIENTE FOREIGN KEY (id_paciente) REFERENCES PACIENTE(id_paciente) ON DELETE CASCADE,
    CONSTRAINT FK_CITA_MEDICO FOREIGN KEY (id_medico) REFERENCES MEDICO(id_medico) ON DELETE CASCADE
);
GO

CREATE TABLE HISTORIAL_CLINICO (
    id_historial INT IDENTITY(1,1) PRIMARY KEY,
    id_paciente INT UNIQUE NOT NULL,
    fecha_apertura DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    alergias VARCHAR(MAX),
    antecedentes_familiares VARCHAR(MAX),
    antecedentes_personales VARCHAR(MAX),
    grupo_sanguineo VARCHAR(5),
    CONSTRAINT FK_HISTORIAL_PACIENTE FOREIGN KEY (id_paciente) REFERENCES PACIENTE(id_paciente) ON DELETE CASCADE
);
GO

CREATE TABLE DIAGNOSTICO (
    id_diagnostico INT IDENTITY(1,1) PRIMARY KEY,
    id_historial INT NOT NULL,
    id_cita INT NOT NULL,
    codigo_cie10 VARCHAR(10) NOT NULL,
    descripcion VARCHAR(255) NOT NULL,
    fecha_diagnostico DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    tipo VARCHAR(20) CHECK (tipo IN ('Principal', 'Secundario', 'Presuntivo')),
    CONSTRAINT FK_DIAG_HISTORIAL FOREIGN KEY (id_historial) REFERENCES HISTORIAL_CLINICO(id_historial) ON DELETE CASCADE,
    CONSTRAINT FK_DIAG_CITA FOREIGN KEY (id_cita) REFERENCES CITA(id_cita) -- Sin CASCADE para evitar ciclos
);
GO

CREATE TABLE ACTIVIDAD_ASISTENCIAL (
    id_actividad INT IDENTITY(1,1) PRIMARY KEY,
    id_cita INT NOT NULL,
    tipo VARCHAR(50) NOT NULL CHECK (tipo IN ('Consulta', 'Procedimiento', 'Examen', 'Terapia')),
    descripcion VARCHAR(255) NOT NULL,
    costo DECIMAL(10, 2) DEFAULT 0.00,
    fecha_realizacion DATETIME DEFAULT GETDATE(),
    CONSTRAINT FK_ACTIVIDAD_CITA FOREIGN KEY (id_cita) REFERENCES CITA(id_cita) ON DELETE CASCADE
);
GO

