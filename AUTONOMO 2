CREATE VIEW vista_recepcionista AS
SELECT
    c.id_cita,
    CONCAT(p.nombres, ' ', p.apellidos) AS nombre_paciente,
    p.cedula AS cedula_paciente,
    p.telefono AS telefono_paciente,
    CONCAT(m.nombres, ' ', m.apellidos) AS nombre_medico,
    e.nombre AS especialidad,
    c.fecha_hora,
    c.motivo,
    c.estado
FROM CITA c
INNER JOIN PACIENTE p ON c.id_paciente = p.id_paciente
INNER JOIN MEDICO m ON c.id_medico = m.id_medico
INNER JOIN ESPECIALIDAD e ON m.id_especialidad = e.id_especialidad;
GO

CREATE VIEW vista_medico AS
SELECT
    CONCAT(p.nombres, ' ', p.apellidos) AS nombre_paciente,
    p.cedula,
    p.fecha_nacimiento,
    h.alergias,
    h.antecedentes_familiares,
    h.antecedentes_personales,
    h.grupo_sanguineo,
    d.fecha_diagnostico,
    d.codigo_cie10,
    d.descripcion AS diagnostico,
    d.tipo AS tipo_diagnostico
FROM PACIENTE p
INNER JOIN HISTORIAL_CLINICO h ON p.id_paciente = h.id_paciente
LEFT JOIN DIAGNOSTICO d ON h.id_historial = d.id_historial;
GO

CREATE VIEW vista_administrador AS
SELECT
    CONCAT(m.nombres, ' ', m.apellidos) AS nombre_medico,
    e.nombre AS especialidad,
    COUNT(DISTINCT c.id_cita) AS total_citas,
    COUNT(DISTINCT a.id_actividad) AS total_actividades,
    COALESCE(SUM(a.costo), 0) AS ingresos_totales
FROM MEDICO m
INNER JOIN ESPECIALIDAD e ON m.id_especialidad = e.id_especialidad
LEFT JOIN CITA c ON m.id_medico = c.id_medico
LEFT JOIN ACTIVIDAD_ASISTENCIAL a ON c.id_cita = a.id_cita
GROUP BY m.id_medico, m.nombres, m.apellidos, e.nombre;
GO

CREATE VIEW vista_diagnosticos_frecuentes AS
SELECT
    codigo_cie10,
    descripcion,
    COUNT(*) AS total_casos
FROM DIAGNOSTICO
GROUP BY codigo_cie10, descripcion;
GO

CREATE FUNCTION calcular_edad (@fecha_nac DATE)
RETURNS INT
AS
BEGIN
    DECLARE @edad INT;
    SET @edad = DATEDIFF(YEAR, @fecha_nac, GETDATE()) 
                - CASE 
                    WHEN (MONTH(@fecha_nac) > MONTH(GETDATE())) 
                         OR (MONTH(@fecha_nac) = MONTH(GETDATE()) AND DAY(@fecha_nac) > DAY(GETDATE()))
                    THEN 1 ELSE 0 
                  END;
    RETURN @edad;
END;
GO

CREATE PROCEDURE registrar_cita
    @p_id_paciente INT,
    @p_id_medico INT,
    @p_fecha_hora DATETIME,
    @p_motivo VARCHAR(255)
AS
BEGIN
    INSERT INTO CITA (id_paciente, id_medico, fecha_hora, motivo, estado)
    VALUES (@p_id_paciente, @p_id_medico, @p_fecha_hora, @p_motivo, 'Programada');
    
    PRINT 'Cita registrada exitosamente para el paciente ' + CAST(@p_id_paciente AS VARCHAR);
END;
GO

CREATE TRIGGER trg_actualizar_cita
ON ACTIVIDAD_ASISTENCIAL
AFTER INSERT
AS
BEGIN
    UPDATE CITA 
    SET estado = 'Atendida' 
    WHERE id_cita IN (SELECT id_cita FROM inserted);
END;
GO

SELECT
    id_paciente,
    nombres,
    apellidos,
    cedula,
    fecha_nacimiento,
    dbo.calcular_edad(fecha_nacimiento) AS edad
FROM PACIENTE
ORDER BY apellidos, nombres;
GO

SELECT
    c.id_cita,
    CONCAT(p.nombres, ' ', p.apellidos) AS paciente,
    CONCAT(m.nombres, ' ', m.apellidos) AS medico,
    c.fecha_hora,
    c.motivo
FROM CITA c
INNER JOIN PACIENTE p ON c.id_paciente = p.id_paciente
INNER JOIN MEDICO m ON c.id_medico = m.id_medico
WHERE CAST(c.fecha_hora AS DATE) = CAST(GETDATE() AS DATE)
AND c.estado = 'Programada';
GO

SELECT
    e.nombre AS especialidad,
    COUNT(DISTINCT a.id_actividad) AS total_actividades,
    SUM(a.costo) AS ingresos_totales
FROM ESPECIALIDAD e
INNER JOIN MEDICO m ON e.id_especialidad = m.id_especialidad
INNER JOIN CITA c ON m.id_medico = c.id_medico
INNER JOIN ACTIVIDAD_ASISTENCIAL a ON c.id_cita = a.id_cita
GROUP BY e.nombre
ORDER BY ingresos_totales DESC;
GO

SELECT TOP 5
    codigo_cie10,
    descripcion,
    COUNT(*) AS total_casos
FROM DIAGNOSTICO
GROUP BY codigo_cie10, descripcion
ORDER BY total_casos DESC;
GO

